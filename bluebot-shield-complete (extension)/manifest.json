{
  "manifest_version": 3,
  "name": "BlueBot Browser Shield",
  "version": "1.0.0",
  "description": "Enterprise browser detection & response. Deployed by IT on managed devices; activates only under managed policy.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "webNavigation",
    "management",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["detector.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BlueBot Browser Shield"
  },
  "storage": {
    "managed_schema": "schema.json"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
